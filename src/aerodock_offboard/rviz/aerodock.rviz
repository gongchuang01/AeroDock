Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Ground Grid
      Plane: XY
      Plane Cell Count: 20
    - Class: rviz_default_plugins/Path
      Color: 255; 50; 50
      Enabled: true
      Line Style: Lines
      Line Width: 0.06
      Name: Actual Flight Path
      Topic:
        Value: /aerodock/trajectory
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Planned Waypoints
      Topic:
        Value: /aerodock/waypoints
  Enabled: true
  Global Options:
    Background Color: 28; 32; 38
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Focal Point:
        X: 1.5
        Y: 1.5
        Z: 1.5
      Name: AeroDock View
      Pitch: 0.65
      Yaw: 0.8
Window Geometry:
  Height: 720
  Width: 1100
